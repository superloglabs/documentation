            "pages": [
              "assistants/claude"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/overview",
              "integrations/github",
              "integrations/slack",
              "integrations/sentry",
              "integrations/datadog",
              "integrations/linear",
